# ---- Unity ----
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated project files
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# IDE / OS
.vs/
.idea/
.vscode/
.gradle/
.consulo/
.DS_Store
Thumbs.db
~$*
*.tmp


# Rider plugin Unity adds automatically
/[Aa]ssets/[Pp]lugins/[Ee]ditor/[Jj]et[Bb]rains*
/[Aa]ssets/[Pp]lugins/[Ee]ditor/[Jj]et[Bb]rains*.meta

# Builds and packaging
*_BurstDebugInformation_DoNotShip/
*.apk
*.aab
*.unitypackage
*.app
ExportedObj/
crashlytics-build.properties
sysinfo.txt

# Unity Addressables / Burst
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
